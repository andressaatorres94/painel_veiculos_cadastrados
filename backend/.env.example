# Copie este arquivo para .env e preencha com os dados do seu ambiente.
# O .env não vai para o git.

# Nome do DSN ODBC configurado no Windows (Fontes de Dados ODBC 64 bits).
# Recomendado: DSN com autenticação do Windows, sem usuário/senha em arquivo.
DB_DSN=NOME_DO_DSN

# Nome da coluna de data de inclusão na view (padrão: DataInclusao)
# COL_DATA_INCLUSAO=DataInclusao

# Porta do servidor (padrão: 3000)
# PORT=3000
